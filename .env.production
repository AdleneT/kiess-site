# Build de production (npm run build, Vercel compris) : adresses publiques,
# déjà visibles dans le code du site. Un .env.production.local les remplace.
VITE_SITE_URL=https://kiess.fr
VITE_API_URL=https://api.kiess.fr
# Stockage des photos (URL présignées) : tout Cloudflare R2. Mettre l'origine
# exacte de S3_ENDPOINT (API, Render) pour une CSP plus stricte.
VITE_UPLOADS_ORIGIN=https://*.r2.cloudflarestorage.com
# Connexions sociales : vides = boutons masqués, tant que https://kiess.fr/
# n'est pas déclaré comme adresse de retour chez chaque fournisseur.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_SERVICES_ID=
VITE_FACEBOOK_APP_ID=
VITE_DISCORD_CLIENT_ID=
