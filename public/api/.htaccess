# Kiess — dossier api/ : seul preinscription.php est accessible depuis le web.
Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
  <Files "preinscription.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "preinscription.php">
    Allow from all
  </Files>
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
