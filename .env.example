# Adresse de l'API Kiess, sans / final (même valeur que EXPO_PUBLIC_API_URL du mobile).
# Le formulaire envoie alors les préinscriptions à {VITE_API_URL}/pre-registrations
# et les liens légaux pointent vers {VITE_API_URL}/legal/cgu et /legal/privacy.
# Vide = mode démo : rien n'est envoyé, la requête est simulée (voir src/beta/submit.ts).
VITE_API_URL=

# Surcharges facultatives, si l'un de ces liens doit pointer ailleurs.
# VITE_BETA_ENDPOINT=https://api.exemple.fr/pre-registrations
# VITE_CGU_URL=https://kiess.fr/cgu
# VITE_PRIVACY_URL=https://kiess.fr/confidentialite
