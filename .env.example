# Adresse publique du site, sans / final : balises canonical, Open Graph, sitemap.
VITE_SITE_URL=https://kiess.fr

# Adresse de l'API Kiess, sans / final : la même que l'app (EXPO_PUBLIC_API_URL).
# L'inscription du site crée un compte de l'app avec les mêmes routes.
# Vide : mode démo (le parcours s'affiche mais aucun compte n'est créé).
# Côté API : ajouter l'adresse du site à CORS_ORIGINS.
VITE_API_URL=

# Origine du stockage des photos (adresse des URL présignées S3 / R2), si elle
# diffère de l'API. Ex. : https://<compte>.r2.cloudflarestorage.com
# Ajoutée, comme l'API, aux adresses autorisées par la CSP (connect-src).
VITE_UPLOADS_ORIGIN=

# ── Connexions sociales (identifiants publics « application web ») ──────────
# Adresse de retour à déclarer chez chaque fournisseur : l'accueil du site,
# ex. https://kiess.fr/ (et http://localhost:5173/ pour le développement).
# Vide : bouton masqué en production ; en développement, jeton de test de l'API.

# Google Cloud → Identifiants → ID client OAuth « Application Web ».
# L'ajouter aussi à GOOGLE_CLIENT_IDS de l'API.
VITE_GOOGLE_CLIENT_ID=

# Apple Developer → Identifiers → Services ID (Sign in with Apple, domaine + adresse de retour).
# L'ajouter aussi à APPLE_CLIENT_IDS de l'API.
VITE_APPLE_SERVICES_ID=

# Meta for Developers → même application que l'app (FACEBOOK_APP_ID de l'API),
# produit « Facebook Login » → plateforme Web.
VITE_FACEBOOK_APP_ID=

# Discord Developer Portal → Applications → OAuth2 : Client ID.
# Le secret reste sur l'API (DISCORD_CLIENT_SECRET) ; adresse de retour dans DISCORD_REDIRECT_URIS.
VITE_DISCORD_CLIENT_ID=
