# Adresse publique du site, sans / final : balises canonical, Open Graph, sitemap.
VITE_SITE_URL=https://kiess.fr

# Par défaut (vide), les préinscriptions partent vers le script PHP livré avec le
# site (public/api/preinscription.php → base MySQL Hostinger).
# Quand l'API Kiess sera en ligne : son adresse, sans / final (même valeur que
# EXPO_PUBLIC_API_URL du mobile). Le formulaire poste alors sur
# {VITE_API_URL}/pre-registrations. Penser à ajouter ce domaine à connect-src
# dans public/.htaccess.
VITE_API_URL=

# Facultatif : URL complète du formulaire, prioritaire sur tout le reste.
# VITE_BETA_ENDPOINT=
